# ── Server ──────────────────────────────────────────────
PORT=5001
# Use a long random string in production!
JWT_SECRET=change-me-to-a-long-random-string

# ── Admin access ────────────────────────────────────────
# The admin panel opens at /admin/login with this code
ADMIN_CODE=2006
# Optional username/password fallback (users table)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# ── Supabase (optional) ─────────────────────────────────
# Leave blank to use the local JSON file store (server/data/db.json).
# To enable Supabase:
#   1. Create a project at https://supabase.com
#   2. Run the SQL in server/supabase/schema.sql in the SQL editor
#      (it enables RLS policies so the publishable key can read/write)
#   3. Copy Project URL + a key here:
#      - SUPABASE_KEY (publishable/anon) — works with the schema's RLS policies
#      - or SUPABASE_SERVICE_ROLE_KEY — bypasses RLS (most privileged, server-only)
SUPABASE_URL=
SUPABASE_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
